# Copy to .env.local (local) or set in the host's dashboard (production).

# Local: where the evening job writes its JSON (default ../data/web)
# MBF_DATA_DIR=../data/web

# Production: base URL the evening job publishes data/web to (no trailing slash)
# MBF_DATA_URL=https://example.com/marketlens-data

# Invite-only mode: one code per person; unset for an open site
# ACCESS_CODES=ahmad-7f3k,guest-q9x2
# ACCESS_SECRET=replace-with-a-long-random-string
